<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>
    <item android:top="48dp" android:gravity="center">
        <bitmap android:src="@mipmap/ic_launcher"
            android:gravity="center"
            android:width="64dp"
            android:height="64dp" />
    </item>
    <item android:top="160dp" android:gravity="center_horizontal">
        <bitmap android:gravity="center" android:src="@drawable/ic_splash_text" />
    </item>
</layer-list>
